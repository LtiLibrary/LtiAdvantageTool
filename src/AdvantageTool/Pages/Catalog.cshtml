@page "/Tool/Catalog"
@model AdvantageTool.Pages.CatalogModel
@{ ViewData["Title"] = "Pick content"; }

<h1>Pick content</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Settings is not null)
{
    <p>
        Items are sent back to the platform as deep linking content items.
        The platform accepts: <code>@string.Join(", ", Model.Settings.AcceptTypes ?? [])</code>.
        @if (!Model.Settings.AcceptMultiple)
        {
            <strong>Only one item can be returned.</strong>
        }
    </p>

    <form method="post">
        <input type="hidden" asp-for="LaunchId"/>
        <table class="table align-middle">
            <thead><tr><th></th><th>Item</th><th>Type</th><th>Gradebook column (lineItem)</th></tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Offered.Count; i++)
            {
                var entry = Model.Offered[i];
                <tr>
                    <td>
                        <input type="hidden" name="Items[@i].Key" value="@entry.Key"/>
                        <input class="form-check-input item-select" type="checkbox" name="Items[@i].Selected" value="true"
                               checked="@(Model.Items.ElementAtOrDefault(i)?.Selected == true)"/>
                    </td>
                    <td>@entry.Title<br/><small class="text-muted">@entry.Description</small></td>
                    <td><code>@entry.Type</code></td>
                    <td>
                        @if (entry.Type == LtiAdvantage.Constants.ContentItemTypes.LtiLink)
                        {
                            <div class="d-flex gap-2 align-items-center">
                                <input class="form-check-input" type="checkbox" name="Items[@i].Graded" value="true" title="Create a line item"/>
                                <input class="form-control form-control-sm" style="width:6em" type="number" name="Items[@i].ScoreMaximum" value="100" title="scoreMaximum"/>
                                <input class="form-control form-control-sm" style="width:8em" type="text" name="Items[@i].Tag" placeholder="tag"/>
                                <select class="form-select form-select-sm w-auto" name="Items[@i].GradesReleased" title="gradesReleased">
                                    <option value="">(platform default)</option>
                                    <option value="true">grades released</option>
                                    <option value="false">grades hidden</option>
                                </select>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>

        @if (Model.Targets.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label" for="Target">Open links in</label>
                <select class="form-select w-auto" name="Target" id="Target">
                    <option value="">(platform default)</option>
                    @foreach (var target in Model.Targets)
                    {
                        <option value="@target">@(target == "embed" ? "embed (plain links only)" : target)</option>
                    }
                </select>
            </div>
        }

        <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add selected</button>
        <button type="submit" asp-page-handler="Cancel" class="btn btn-secondary">Cancel</button>
    </form>

    @if (!Model.Settings.AcceptMultiple)
    {
        <script>
            // accept_multiple is false: keep at most one item checked.
            document.querySelectorAll('.item-select').forEach(box => box.addEventListener('change', () => {
                if (box.checked) document.querySelectorAll('.item-select').forEach(other => { if (other !== box) other.checked = false; });
            }));
        </script>
    }
}
